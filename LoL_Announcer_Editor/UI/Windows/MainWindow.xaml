<Window x:Class="LoL_Announcer_Editor.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoL_Announcer_Editor.UI.Windows"
        xmlns:converters="clr-namespace:LoL_Announcer_Editor.UI.Converters"
        xmlns:models="clr-namespace:LoL_Announcer_Editor.Models"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        FontSize="15"
        Background="{DynamicResource BackgroundBrush}"
        Title="LoL Announcer Manager" Height="850" Width="1300">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringVisibilityConverter x:Key="StringToVis"/>
        <converters:WemNameConverter x:Key="WemNameConverter"/>
        <converters:WemArrowConverter x:Key="ReplacementFileNameToArrowRun"/>
        <converters:NodeTypeToIconConverter x:Key="NodeTypeToIconConverter"/>
    </Window.Resources>

    <DockPanel>
        <!-- Modern Menu -->
        <Menu x:Name="Menu" DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
            <MenuItem Header="File">
                <MenuItem Header="Settings" Click="SettingsMenu_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Appearance">
                <MenuItem Header="Theme">
                    <MenuItem Header="Windows 11 (Dark)" Click="ThemeWin11_Click"/>
                    <MenuItem Header="Windows 10 (Dark)" Click="ThemeWin10_Click"/>
                    <MenuItem Header="Hextech (Dark)" Click="ThemeHextech_Click"/>
                    <MenuItem Header="Light Mode" Click="ThemeLight_Click"/>
                </MenuItem>
                <MenuItem Header="Accent Color" Click="PickAccentColor_Click"/>
                <Separator/>
                <MenuItem Header="Reset to Default" Click="ResetAppearance_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- File Paths -->
                <RowDefinition Height="*"/>    <!-- Main Content -->
                <RowDefinition Height="Auto"/> <!-- Progress & Credits -->
            </Grid.RowDefinitions>

            <!-- File Paths Section -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Content="Select BIN" Click="OpenBinFile_Click" Width="120" Grid.Row="0" Grid.Column="0"/>
                    <TextBox x:Name="BinFilePath" Grid.Row="0" Grid.Column="1" Margin="10,0" IsReadOnly="True"/>
                    
                    <Button Content="Select Audio" Click="OpenWpkFile_Click" Width="120" Grid.Row="2" Grid.Column="0"/>
                    <TextBox x:Name="WpkFilePath" Grid.Row="2" Grid.Column="1" Margin="10,0" IsReadOnly="True"/>

                    <Button Content="Select Events" Click="OpenBnkFile_Click" Width="120" Grid.Row="4" Grid.Column="0"/>
                    <TextBox x:Name="BnkFilePath" Grid.Row="4" Grid.Column="1" Margin="10,0" IsReadOnly="True"/>
                </Grid>
            </Border>

            <!-- Main Content Section -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- TreeView with Virtualization Enabled for performance with large datasets -->
                <TreeView x:Name="TreeView" Grid.Column="0" Margin="0,0,15,0" 
                          SelectedItemChanged="TreeView_SelectedItemChanged"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Expand Selected Branch" Click="ExpandSelected_Click"/>
                            <MenuItem Header="Collapse Selected Branch" Click="CollapseSelected_Click"/>
                            <Separator/>
                            <MenuItem Header="Expand Everything" Click="ExpandAll_Click"/>
                            <MenuItem Header="Collapse Everything" Click="CollapseAll_Click"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="MultiSelectCheckbox"
                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          IsThreeState="True"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding ShowCheckbox, Converter={StaticResource BoolToVis}}"/>
                                <Path Data="{Binding NodeType, Converter={StaticResource NodeTypeToIconConverter}}" 
                                      Fill="{DynamicResource AccentBrush}" 
                                      Stretch="Uniform" 
                                      Width="16" Height="16" 
                                      Margin="8,0,5,0"
                                      VerticalAlignment="Center"/>
                                <StackPanel Orientation="Vertical" Margin="3,0,0,0">
                                    <TextBlock FontSize="16" Foreground="{DynamicResource TextBrush}">
                                        <TextBlock.Inlines>
                                            <Run Text="{Binding Name}"/>
                                            <Run Text="{Binding ReplacementFileName, Converter={StaticResource ReplacementFileNameToArrowRun}}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                                        </TextBlock.Inlines>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <!-- Actions Panel -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Operations" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                        <Button x:Name="ParseFilesButton" Style="{StaticResource PrimaryButton}" Content="Parse Files" Height="40" Margin="0,0,0,8" Click="ParseFilesButton_Click" IsEnabled="False"/>
                        <Button x:Name="DeleteTreeView" Content="Clear Treeview" Height="35" Margin="0,0,0,8" Click="DeleteTreeView_Click" IsEnabled="False"/>
                        <Button x:Name="ExtractSelection" Content="Extract Selection" Height="35" Margin="0,0,0,8" Click="ExtractSelection_Click" IsEnabled="False"/>
                        
                        <Separator Margin="0,10" Background="{DynamicResource BorderBrush}"/>
                        
                        <TextBlock Text="Export &amp; Packaging" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                        <Button x:Name="ExportWwiseProject" Content="Export Wwise Template" Height="35" Margin="0,0,0,8" Click="ExportWwiseProject_Click" IsEnabled="False"/>
                        <Button x:Name="SaveAsBnkWpkButton" Content="Save as audio WPK" Height="35" Margin="0,0,0,8" Click="SaveAsBnkWpk_Click" IsEnabled="False"/>
                        <Button x:Name="PackageWemsToWpk" Content="Package WEMs to WPK" Height="35" Margin="0,0,0,8" Click="PackageWemsToWpk_Click" IsEnabled="False"/>

                        <Separator Margin="0,10" Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Audio Controls" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrush}"/>
                        <Button x:Name="ReplaceWemDataButton" Content="Replace WEM Data" Height="35" Margin="0,0,0,8" Click="ReplaceWemData_Click" IsEnabled="False"/>
                        <Button x:Name="PlayAudioButton" Content="Play Audio" Height="35" Margin="0,0,0,8" Click="PlaySoundButton_Click" IsEnabled="False"/>
                        <Button x:Name="StopAllSoundsButton" Content="Stop All Sounds" Height="35" Margin="0,0,0,8" Click="StopAllSoundsButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Bottom Section (Progress & Credits) -->
            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Credits -->
                    <ColumnDefinition Width="*"/>    <!-- Progress -->
                    <ColumnDefinition Width="Auto"/> <!-- Placeholder -->
                </Grid.ColumnDefinitions>

                <Button Content="Credits" 
                        Click="CreditsMenu_Click" 
                        Padding="10,2" 
                        FontSize="12" 
                        Height="24" 
                        VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="20,0">
                    <ProgressBar x:Name="ExtractionProgressBar"
                                 Height="8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="ProgressText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextBrush}"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
