<Window x:Class="LoL_Announcer_Editor.UI.Windows.CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credits" Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="10" Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="CREDITS" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Software Developer" HorizontalAlignment="Center" Opacity="0.7" FontSize="14"/>
                <TextBlock Text="NoxianWill" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,15"/>
                
                <TextBlock Text="Twitter / X" HorizontalAlignment="Center" Opacity="0.7" FontSize="14"/>
                <TextBlock Text="https://x.com/walidbouachir" HorizontalAlignment="Center" FontSize="16" Margin="0,0,0,15" Cursor="Hand" MouseLeftButtonDown="Link_Click"/>
                
                <TextBlock Text="GitHub" HorizontalAlignment="Center" Opacity="0.7" FontSize="14"/>
                <TextBlock x:Name="GitHubLink" Text="https://github.com/noxianwill" HorizontalAlignment="Center" FontSize="16" Margin="0,0,0,15" Cursor="Hand" MouseLeftButtonDown="GitHubLink_Click"/>

                <TextBlock Text="Riot ID" HorizontalAlignment="Center" Opacity="0.7" FontSize="14"/>
                <TextBlock Text="Sizzling#EUW" HorizontalAlignment="Center" FontSize="16"/>
            </StackPanel>

            <Button Grid.Row="2" Content="Close" Width="100" Height="30" Click="Close_Click" Style="{StaticResource PrimaryButton}"/>
        </Grid>
    </Border>
</Window>
