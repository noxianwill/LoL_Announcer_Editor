<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="BackgroundColor">#202020</Color>
    <Color x:Key="SurfaceColor">#2C2C2C</Color>
    <Color x:Key="InputBackgroundColor">#323232</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#444444</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
</ResourceDictionary>
