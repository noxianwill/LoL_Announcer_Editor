<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Color x:Key="BackgroundColor">#171717</Color>
    <Color x:Key="SurfaceColor">#1F1F1F</Color>
    <Color x:Key="InputBackgroundColor">#2B2B2B</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#333333</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
</ResourceDictionary>
