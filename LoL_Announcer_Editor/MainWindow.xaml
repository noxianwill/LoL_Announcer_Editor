<Window x:Class="LoL_Announcer_Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoL_Announcer_Editor"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        FontSize="15"
        Title="LoL Announcer Manager" Height="800" Width="1200">

    <DockPanel>
        <Menu x:Name="Menu" DockPanel.Dock="Top">
            <MenuItem Header="Settings">
                <MenuItem Header="Settings">
                    <MenuItem Header="Settings" Click="SettingsMenu_Click"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Export">
                <MenuItem Header="Export BNK">
                    <MenuItem Header="Json" Click="ExportToJson_Click"/>
                </MenuItem>
                <MenuItem Header="Export as Wwise Project Template" Click="ExportWwiseProject_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Button Content="select bin file" Click="OpenBinFile_Click" HorizontalAlignment="Left" Margin="7,20,0,0" VerticalAlignment="Top" Width="119"/>
            <Button Content="select audio file" Click="OpenWpkFile_Click" HorizontalAlignment="Left" Margin="7,46,0,0" VerticalAlignment="Top" Width="119"/>
            <Button Content="select events file" Click="OpenBnkFile_Click" HorizontalAlignment="Left" Margin="7,72,0,0" VerticalAlignment="Top" Width="119"/>
            <TextBox Text="C:\Users\walid\Desktop\map11.bin" x:Name="BinFilePath" HorizontalAlignment="Left" Margin="142,20,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="600"/>
            <TextBox Text="C:\Users\walid\Desktop\announcer_global_female1_vo_audio.wpk" x:Name="WpkFilePath" HorizontalAlignment="Left" Margin="142,46,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="600"/>
            <TextBox Text="C:\Users\walid\Desktop\announcer_global_female1_vo_events.bnk" x:Name="BnkFilePath" HorizontalAlignment="Left" Margin="142,72,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="600"/>
            <TreeView x:Name="TreeView" Margin="10,114,300,69" SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.Resources>
                    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                    <local:StringNullOrEmptyToVisibilityConverter x:Key="StringToVis"/>
                    <local:WemDisplayNameConverter x:Key="WemDisplayNameConverter"/>
                    <local:ReplacementFileNameToArrowRunConverter x:Key="ReplacementFileNameToArrowRun"/>
                    <local:IsMarkedForDeletionToTextDecorationConverter x:Key="IsMarkedForDeletionToTextDecoration"/>
                    <local:IsMarkedForDeletionToForegroundConverter x:Key="IsMarkedForDeletionToForeground"/>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="MultiSelectCheckbox"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      IsThreeState="True"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding ShowCheckbox, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                                <TextBlock FontSize="20"
                                           TextDecorations="{Binding IsMarkedForDeletion, Converter={StaticResource IsMarkedForDeletionToTextDecoration}}"
                                           Foreground="{Binding IsMarkedForDeletion, Converter={StaticResource IsMarkedForDeletionToForeground}}">
                                    <TextBlock.Inlines>
                                        <Run Text="{Binding Name}"/>
                                        <Run Text="{Binding ReplacementFileName, Converter={StaticResource ReplacementFileNameToArrowRun}}" Foreground="Gray"/>
                                    </TextBlock.Inlines>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <ProgressBar x:Name="ExtractionProgressBar"
                         Minimum="0"
                         Maximum="100"
                         Height="24"
                         Margin="10,680,300,0"
                         VerticalAlignment="Top"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="ProgressText"
                       Margin="10,710,300,0"
                       FontSize="16"
                       VerticalAlignment="Top"
                       Visibility="Collapsed"/>
            <Button x:Name="ParseFilesButton" Content="Parse files" HorizontalAlignment="Left" Margin="948,114,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="ParseFilesButton_Click"/>
            <Button x:Name="DeleteTreeView" Content="Delete Treeview" HorizontalAlignment="Left" Margin="948,151,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="DeleteTreeView_Click"/>
            <Button x:Name="ExtractSelection" Content="Extract Selection" HorizontalAlignment="Left" Margin="948,188,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="ExtractSelection_Click"/>
            <Button x:Name="SaveAsBnkWpkButton" Content="Save as audio WPK" HorizontalAlignment="Left" Margin="948,262,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="SaveAsBnkWpk_Click" IsEnabled="False"/>
            <Button x:Name="AddWemFileButton" Content="Add WEM file" HorizontalAlignment="Left" Margin="948,299,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="AddWemFile_Click" IsEnabled="False"/>
            <Button x:Name="RemoveWemButton" Content="Remove WEM file" HorizontalAlignment="Left" Margin="948,336,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="RemoveWemButton_Click"/>
            <Button x:Name="SaveBnkFileButton" Content="Save as events BNK" HorizontalAlignment="Left" Margin="948,373,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="SaveBnkFile_Click" IsEnabled="False"/>
            <Button Content="Replace wem data" HorizontalAlignment="Left" Margin="948,410,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="ReplaceWemData_Click"/>
            <Button Content="Play audio" HorizontalAlignment="Left" Margin="948,447,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="PlaySoundButton_Click"/>
            <Button Content="Stop all playing sounds" HorizontalAlignment="Left" Margin="948,484,0,0" VerticalAlignment="Top" Height="32" Width="216" Click="StopAllSoundsButton_Click"/>
        </Grid>
    </DockPanel>
</Window>
